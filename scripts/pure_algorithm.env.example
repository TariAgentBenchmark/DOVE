# Repository and Python environment
export DOVE_ROOT=/path/to/DOVE
export PYTHON_BIN=python

# DOVE model and datasets
export MODEL_PATH=/path/to/pretrained_models/DOVE
export HQVSR_ROOT=/path/to/datasets/train/HQ-VSR
export HQVSR_LIST=/path/to/datasets/train/HQ-VSR.txt
export UDM10_LQ=/path/to/datasets/test/UDM10/LQ-Video
export UDM10_GT=/path/to/datasets/test/UDM10/GT-Video

# Outputs and cluster-specific partitions
export OUTPUT_ROOT=/path/to/outputs
export DECODER_PARTITION=h100
export ENCODER_PARTITION=standard
export EVAL_PARTITION=gpu_computervision

# Optional reproducibility overrides
export RUN_ID=run-001
export SEED=42
export NUM_SAMPLES=1024
export TRAIN_RESOLUTION=17x256x384
